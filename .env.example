# PostgreSQL connection string
# Example: postgresql+psycopg://cuebox:cuebox@localhost:5432/cuebox
DATABASE_URL=

# Path to config.yaml (copy from config.example.yaml)
CONFIG_PATH=./config.yaml

# Metadata providers
TMDB_API_KEY=
OMDB_API_KEY=

# AI provider keys (used by providers configured in config.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Local semantic provider (optional; default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
