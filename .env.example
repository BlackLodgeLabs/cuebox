# PostgreSQL connection string
# Example: postgresql+psycopg://cuebox:cuebox@localhost:5432/cuebox
DATABASE_URL=

# Path to config.yaml (copy from config.example.yaml)
CONFIG_PATH=./config.yaml

# Metadata providers
TMDB_API_KEY=
OMDB_API_KEY=

# AI provider keys (used by providers configured in config.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Local semantic provider (optional; default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: LAN IP for direct API CORS when not using the Next.js proxy (legacy)
# LAN_HOST=192.168.1.142

# Postgres credentials
POSTGRES_USER=cuebox
POSTGRES_PASSWORD=cuebox
POSTGRES_DB=cuebox

# Frontend container run mode:
#   development (default) - `next dev` with hot reload, unminified, for a
#                            copy you're actively coding/testing against
#   production             - `next build` + `next start`, optimized and
#                            minified, for the copy serving your real data
FRONTEND_MODE=development

# Host port overrides (defaults match docker-compose.yml).
# Set different values per copy to run more than one stack on one host,
# e.g. a "dev" checkout on 3001/8001/5434 alongside "prod" on the defaults.
# FRONTEND_PORT=3000
# API_PORT=8000
# POSTGRES_PORT=5433

# Daily backup sidecar (docker compose backup service)
# BACKUP_DIR=/backups
# BACKUP_RETENTION_DAYS=2
# BACKUP_CRON=0 3 * * *
# PGHOST=postgres