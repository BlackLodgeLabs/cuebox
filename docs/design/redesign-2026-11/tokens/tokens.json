{
  "meta": {
    "name": "Cuebox",
    "repo": "BlackLodgeLabs/cuebox",
    "foundationsLocked": "2026-11-14",
    "motionLocked": "2026-11-24",
    "notes": "Only amber may glow. Teal stays flat. Shared ease is cubic-bezier(0.16, 1, 0.3, 1)."
  },
  "color": {
    "bg": "#0B0B0B",
    "surface": "#171717",
    "text": "#F3EDE4",
    "muted": "#A39E96",
    "accent": "#E07A28",
    "teal": "#2A9A94",
    "divider": "#2A2A2A",
    "ink": "#0B0B0B",
    "danger": "#C75B4A",
    "dimSheet": "rgba(11, 11, 11, 0.55)",
    "dimDialog": "rgba(11, 11, 11, 0.62)"
  },
  "effects": {
    "glow": "0 0 18px rgba(224, 122, 40, 0.5)",
    "glowReco": "0 0 18px rgba(224, 122, 40, 0.45)",
    "glowRule": "Only amber may glow. Teal stays flat \u2014 no glow and no teal wash."
  },
  "radius": {
    "default": 12,
    "sm": 8,
    "lg": 16,
    "pill": 999,
    "unit": "px"
  },
  "spacing": {
    "scale": [
      4,
      8,
      16,
      24,
      32,
      48
    ],
    "unit": "px",
    "shell": {
      "phone": [
        390,
        844
      ],
      "statusBar": 54,
      "header": 52,
      "tabBar": 90
    }
  },
  "typography": {
    "families": {
      "display": "Big Shoulders",
      "ui": "Archivo",
      "mono": "IBM Plex Mono"
    },
    "notes": "Wordmark uses Big Shoulders 700 at display optical size (opsz 72). Do not use Inter or IBM Plex Sans.",
    "scale": [
      {
        "name": "display",
        "family": "display",
        "weight": 700,
        "size": 40,
        "use": "Film title on a detail or review hero"
      },
      {
        "name": "title",
        "family": "display",
        "weight": 700,
        "size": 36,
        "use": "Programme title, large sheet titles"
      },
      {
        "name": "page",
        "family": "display",
        "weight": 700,
        "size": 28,
        "use": "Page titles such as Watchlist"
      },
      {
        "name": "section",
        "family": "display",
        "weight": 700,
        "size": 22,
        "use": "Wordmark, sheet titles, mid headings"
      },
      {
        "name": "card",
        "family": "display",
        "weight": 700,
        "size": 18,
        "use": "Section headers, card titles"
      },
      {
        "name": "tile",
        "family": "display",
        "weight": 700,
        "size": 16,
        "use": "Smaller headings and list titles"
      },
      {
        "name": "body",
        "family": "ui",
        "weight": 500,
        "size": 15,
        "use": "Primary UI and synopsis"
      },
      {
        "name": "ui",
        "family": "ui",
        "weight": [
          500,
          600
        ],
        "size": 14,
        "use": "Buttons and secondary body"
      },
      {
        "name": "caption",
        "family": "ui",
        "weight": 500,
        "size": 13,
        "use": "Captions, chips, More"
      },
      {
        "name": "tab",
        "family": "ui",
        "weight": 500,
        "size": 11,
        "use": "Tab bar labels"
      },
      {
        "name": "meta",
        "family": "mono",
        "weight": 400,
        "size": 11,
        "use": "Kickers and metadata; often uppercase, tracking 0.06em"
      },
      {
        "name": "metaSm",
        "family": "mono",
        "weight": 500,
        "size": 10,
        "use": "Badges and small labels"
      }
    ]
  },
  "motion": {
    "ease": {
      "out": {
        "css": "cubic-bezier(0.16, 1, 0.3, 1)",
        "framer": [
          0.16,
          1,
          0.3,
          1
        ],
        "use": "Almost every Cuebox motion"
      },
      "inOut": {
        "css": "cubic-bezier(0.42, 0, 0.58, 1)",
        "framer": [
          0.42,
          0,
          0.58,
          1
        ],
        "use": "Home iris only (smoothstep)"
      },
      "recoSlow": {
        "js": "1 - Math.pow(1 - u, 1.38)",
        "power": 1.38,
        "use": "Recommendation wind-down over 2.5s"
      }
    },
    "home": {
      "logoScale": 0.85,
      "logoUnfoldMsAt1x": 1730,
      "logoUnfoldWallMs": 2035,
      "wordmarkLockMsAt1x": 1610,
      "wordmarkLockWallMs": 1894,
      "beatAfterLockMs": 80,
      "irisStartWallMs": 1974,
      "irisMs": 760,
      "irisEdgePx": [
        1.25,
        12
      ],
      "wordmarkFadeDelayMs": 80,
      "wordmarkFadeMs": 600,
      "chromeStartWallMs": 2674,
      "sectionsStartWallMs": 2734,
      "sectionRisePx": 6,
      "sectionStaggerMs": 70,
      "sectionDurMs": 300
    },
    "recommendation": {
      "cruisePxPerSec": 420,
      "breath": 0,
      "slowMs": 2500,
      "slowPower": 1.38,
      "slowDistPx": 761,
      "highlightRiseMs": 80,
      "highlightHoldMs": 120,
      "highlightFadeMs": 400,
      "highlightOpacity": 0.95,
      "highlightShadow": "0 0 18px rgba(224, 122, 40, 0.45)",
      "expandMs": 580,
      "settleRisePx": 8,
      "settleStaggerMs": 70,
      "settleDurMs": 300
    },
    "detailTicks": {
      "staggerMs": 70,
      "fillMs": 330,
      "ease": "out",
      "glow": false,
      "trigger": 0.4,
      "rowDelayMs": 90
    },
    "reviewStars": {
      "staggerMs": 70,
      "fillMs": 330,
      "ease": "out",
      "bounce": 0.3,
      "bounceMs": 190,
      "savedDelayMs": 40,
      "savedFadeMs": 220,
      "glow": true,
      "glowIntensity": 0.35
    },
    "watchlist": {
      "fadeOutMs": 400,
      "fadeInMs": 600,
      "overlapMs": 200,
      "switchTotalMs": 800,
      "infiniteTriggerPx": 600,
      "pageSize": 18,
      "batchFadeMs": 300,
      "batchStaggerMs": 30
    },
    "appWide": {
      "sheetUpMs": 800,
      "sheetDownMs": 700,
      "sheetDim": 0.55,
      "sheetDimFadeMs": 450,
      "sheetDismissPx": 120,
      "toastInMs": 700,
      "toastOutMs": 600,
      "toastTravelPx": 20,
      "toastStayMs": 2800,
      "searchOpenMs": 700,
      "searchCloseMs": 600,
      "searchFromScale": 0.96,
      "dialogMs": 400,
      "dialogFromScale": 0.92,
      "dialogDim": 0.62,
      "pressScaleDown": 0.04,
      "pressDownMs": 120,
      "pressUpMs": 200,
      "screenFadeMs": 400,
      "numberFlowMs": 400,
      "synopsisMoreMs": 300
    },
    "reducedMotion": {
      "defaultMs": 300,
      "rule": "Appear at once, or a 300ms crossfade. No travel, scale or glow, unless a screen lock says otherwise. Home skips the splash. Recommendation crossfades notes to the settled programme. NumberFlow shows the settled figure."
    },
    "history": {
      "pageSize": 10,
      "stubWidthPx": 76,
      "monthLabels": true,
      "perforation": true,
      "pressScaleDown": 0.04,
      "pressDownMs": 120,
      "pressUpMs": 200,
      "screenFadeMs": 400,
      "infiniteTriggerPx": 600,
      "batchFadeMs": 300,
      "batchStaggerMs": 30,
      "remove": "Swipe left to reveal Remove, or long-press. Both go through the confirm box. No amber on press.",
      "openSession": "Open the locked programme layout titled with the date, not the old three-stage ceremony. Do not replay the shuffle."
    }
  }
}
